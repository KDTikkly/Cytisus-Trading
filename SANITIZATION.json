{
  "artifact": "Cytisus-Trading",
  "version": "1.1.5",
  "implementation_stage": "Longbridge authentication and Paper account readiness",
  "implementation_in_progress": false,
  "language": "en",
  "platforms": [
    "macOS",
    "Windows 11"
  ],
  "fixture_mode_default": true,
  "direct_network_access": true,
  "direct_network_access_scope": "user-triggered model-provider discovery and connectivity requests",
  "fixture_network_access": false,
  "local_cli_process_access": true,
  "longbridge_integration": "read-only data plus bounded authentication and Paper channel readiness",
  "strategy_execution": true,
  "strategy_execution_scope": "local governed processes and deterministic Local Paper execution",
  "strategy_direct_cli_access": false,
  "global_live_lock_default": false,
  "live_adapter": "process-free rejecting boundary",
  "factor_search": true,
  "factor_search_scope": "bounded deterministic local fixture research",
  "portfolio_allocation": true,
  "portfolio_allocation_scope": "local strategy capital budgets, internal netting, and virtual ownership",
  "broker_integrations": [
    "Longbridge CLI read-only data adapter"
    ,
    "Longbridge Terminal bounded authentication adapter"
  ],
  "account_identifiers": false,
  "synthetic_local_paper_positions_and_orders": true,
  "real_positions_or_orders": false,
  "quant_worker_separate_process": true,
  "quant_worker_broker_access": false,
  "python_runtime_user_selected": true,
  "accelerator_readiness_requires_runtime_check": true,
  "cpu_fallback": true,
  "agent_shell_access": false,
  "agent_arbitrary_file_access": false,
  "agent_broker_secret_access": false,
  "agent_order_modes": [
    "SuggestOnly",
    "ConfirmEveryOrder",
    "BoundedAutonomy"
  ],
  "tokens_or_api_keys": false,
  "user_supplied_model_api_keys": true,
  "model_key_storage": [
    "macOS Keychain Services",
    "Windows DPAPI CurrentUser"
  ],
  "model_key_plaintext_persistence": false,
  "model_provider_authorization_separate_from_longbridge": true,
  "model_provider_protocols": [
    "OpenAICompatible",
    "AnthropicCompatible",
    "GeminiCompatible"
  ],
  "model_provider_fixture_tests_only": true,
  "personal_paths": false,
  "repository_sample_data_only": true,
  "runtime_real_market_data_optional": true,
  "live_execution": false,
  "trade_execution": false,
  "local_paper_execution": true,
  "local_persistence": [
    "non-sensitive settings",
    "schema and migration versions",
    "market-data cache",
    "universe snapshots",
    "strategy manifests and state",
    "parameter change history",
    "bounded Live authorizations without credentials",
    "factor definitions and append-only trial records",
    "Local Paper execution state and virtual ledger",
    "model-provider metadata and secure-storage references",
    "provider model capability records",
    "primary and fallback model assignments",
    "sanitized provider-test events",
    "algorithm project versions and file hashes",
    "compute job metadata and checkpoint references",
    "ONNX model registry metadata",
    "synthetic account mappings",
    "bounded Agent order authorizations without credentials",
    "application logs",
    "audit events"
  ],
  "longbridge_persisted_fields": [
    "account_environment",
    "account_channel",
    "status_checked_at",
    "cli_version",
    "permissions_summary"
  ],
  "raw_longbridge_authentication_persisted": false,
  "longbridge_authorization_code_persisted": false,
  "release_artifacts": [
    "Cytisus-Trading-1.1.5-universal.dmg",
    "Cytisus-Trading-1.1.5-win11-x64.exe"
  ]
}
