<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>CytisusTrading</AssemblyName>
    <RootNamespace>CytisusTrading.Windows</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.1.0</Version>
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
    <FileVersion>1.1.0.0</FileVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <NeutralLanguage>en-US</NeutralLanguage>
    <Product>Cytisus-Trading</Product>
    <Description>Local quantitative operations and read-only market-data console for Windows 11.</Description>
    <Authors>Cytisus-Trading</Authors>
    <Copyright>Copyright Cytisus-Trading contributors</Copyright>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <ApplicationIcon>..\Resources\ProductIcon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="..\Resources\ProductLogo.png" Link="Resources\ProductLogo.png" />
    <Resource Include="..\Resources\ProductIcon.ico" Link="Resources\ProductIcon.ico" />
    <EmbeddedResource Include="..\fixtures\factors\*.json">
      <Link>fixtures\factors\%(Filename)%(Extension)</Link>
    </EmbeddedResource>
    <EmbeddedResource Include="..\fixtures\longbridge\*.json">
      <Link>fixtures\longbridge\%(Filename)%(Extension)</Link>
    </EmbeddedResource>
    <EmbeddedResource Include="..\fixtures\strategies\*.json">
      <Link>fixtures\strategies\%(Filename)%(Extension)</Link>
    </EmbeddedResource>
    <EmbeddedResource Include="..\fixtures\strategies\*.ndjson">
      <Link>fixtures\strategies\%(Filename)%(Extension)</Link>
    </EmbeddedResource>
    <EmbeddedResource Include="..\fixtures\execution\*.json">
      <Link>fixtures\execution\%(Filename)%(Extension)</Link>
    </EmbeddedResource>
  </ItemGroup>
</Project>
