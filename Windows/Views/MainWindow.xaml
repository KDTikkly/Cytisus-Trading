                                        <DataGridTextColumn Header="Transfer" Binding="{Binding TransferId}" Width="*" />
                                        <DataGridTextColumn Header="Seller" Binding="{Binding SellerStrategyId}" Width="180" />
                                        <DataGridTextColumn Header="Buyer" Binding="{Binding BuyerStrategyId}" Width="180" />
                                        <DataGridTextColumn Header="Quantity" Binding="{Binding Quantity}" Width="90" />
                                        <DataGridTextColumn Header="Reference" Binding="{Binding ReferencePriceSource}" Width="180" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <DataGrid ItemsSource="{Binding ExecutionOrders}"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          CanUserAddRows="False"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          MaxHeight="200">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Order" Binding="{Binding OrderId}" Width="*" />
                                        <DataGridTextColumn Header="Mode" Binding="{Binding ModeLabel}" Width="100" />
                                        <DataGridTextColumn Header="State" Binding="{Binding State}" Width="110" />
                                        <DataGridTextColumn Header="Side" Binding="{Binding Side}" Width="70" />
                                        <DataGridTextColumn Header="Quantity" Binding="{Binding Quantity}" Width="90" />
                                        <DataGridTextColumn Header="Correlation" Binding="{Binding CorrelationId}" Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <DataGrid ItemsSource="{Binding ExecutionFills}"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          CanUserAddRows="False"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          MaxHeight="200">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Fill" Binding="{Binding FillId}" Width="*" />
                                        <DataGridTextColumn Header="Order" Binding="{Binding OrderId}" Width="*" />
                                        <DataGridTextColumn Header="Side" Binding="{Binding Side}" Width="70" />
                                        <DataGridTextColumn Header="Quantity" Binding="{Binding Quantity}" Width="90" />
                                        <DataGridTextColumn Header="Price" Binding="{Binding Price}" Width="90" />
                                        <DataGridTextColumn Header="Fee" Binding="{Binding FeeEstimate}" Width="80" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}" Padding="0">
                            <StackPanel>
                                <TextBlock Text="Virtual Allocations, Shortfalls, and Reconciliation"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Margin="18,16,18,12" />
                                <DataGrid ItemsSource="{Binding ExecutionAllocations}"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          CanUserAddRows="False"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          MaxHeight="200">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Allocation" Binding="{Binding AllocationId}" Width="*" />
                                        <DataGridTextColumn Header="Strategy" Binding="{Binding StrategyId}" Width="180" />
                                        <DataGridTextColumn Header="Intent" Binding="{Binding IntentId}" Width="*" />
                                        <DataGridTextColumn Header="Quantity" Binding="{Binding Quantity}" Width="90" />
                                        <DataGridTextColumn Header="Fill" Binding="{Binding FillId}" Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <DataGrid ItemsSource="{Binding ExecutionShortfalls}"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          CanUserAddRows="False"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          MaxHeight="180">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Shortfall" Binding="{Binding ShortfallId}" Width="*" />
                                        <DataGridTextColumn Header="Strategy" Binding="{Binding StrategyId}" Width="180" />
                                        <DataGridTextColumn Header="Unfilled" Binding="{Binding UnfilledQuantity}" Width="90" />
                                        <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="2*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <DataGrid ItemsSource="{Binding ReconciliationEvents}"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          CanUserAddRows="False"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          MaxHeight="200">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Reconciliation" Binding="{Binding ReconciliationId}" Width="*" />
                                        <DataGridTextColumn Header="Symbol" Binding="{Binding Symbol}" Width="85" />
                                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100" />
                                        <DataGridTextColumn Header="Difference" Binding="{Binding Difference}" Width="90" />
                                        <DataGridTextColumn Header="Diagnostic" Binding="{Binding Diagnostic}" Width="2*" />
                                        <DataGridTextColumn Header="Correlation" Binding="{Binding CorrelationId}" Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="DataPanel"
                              Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="34,30,34,38">
                        <Grid Margin="0,0,0,22">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="READ-ONLY MARKET OPERATIONS"
                                           Style="{StaticResource EyebrowText}" />
                                <TextBlock Text="Data and Universe"
                                           Style="{StaticResource PageTitle}" />
                                <TextBlock Text="Capability-aware local CLI inspection, point-in-time fixtures, cache state, and daily universe decisions."
                                           Style="{StaticResource BodySecondary}" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Content="Check Data"
                                    Style="{StaticResource PrimaryButton}"
                                    Click="RefreshData_Click"
                                    VerticalAlignment="Bottom"
                                    Margin="24,0,0,2" />
                        </Grid>

                        <UniformGrid Columns="4" Margin="0,0,0,18">
                            <Border Style="{StaticResource CardBorder}" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="CLI STATE"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               FontSize="10"
                                               FontWeight="Bold" />
                                    <TextBlock Text="{Binding CliStatus}"
                                               FontSize="22"
                                               FontWeight="SemiBold"
                                               Margin="0,11,0,4" />
                                    <TextBlock Text="{Binding CliVersion}"
                                               Style="{StaticResource BodySecondary}"
                                               FontSize="10" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardBorder}" Margin="4,0,6,0">
                                <StackPanel>
                                    <TextBlock Text="LAST CHECK"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               FontSize="10"
                                               FontWeight="Bold" />
                                    <TextBlock Text="{Binding LastCheckDisplay}"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Margin="0,11,0,4" />
                                    <TextBlock Text="{Binding CliStatusMessage}"
                                               Style="{StaticResource BodySecondary}"
                                               TextWrapping="Wrap"
                                               FontSize="10" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardBorder}" Margin="6,0,4,0">
                                <StackPanel>
                                    <TextBlock Text="DATA FRESHNESS"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               FontSize="10"
                                               FontWeight="Bold" />
                                    <TextBlock Text="{Binding DataFreshnessDisplay}"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Margin="0,11,0,4" />
                                    <TextBlock Text="{Binding MarketSession}"
                                               Style="{StaticResource BodySecondary}"
                                               FontSize="10" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardBorder}" Margin="10,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="LOCAL CACHE"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               FontSize="10"
                                               FontWeight="Bold" />
                                    <TextBlock Text="{Binding CacheSizeDisplay}"
                                               FontSize="22"
                                               FontWeight="SemiBold"
                                               Margin="0,11,0,4" />
                                    <TextBlock Text="JSON records with stable cache keys"
                                               Style="{StaticResource BodySecondary}"
                                               FontSize="10" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,18">
                            <StackPanel>
                                <TextBlock Text="Available Data Permissions"
                                           FontSize="14"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="{Binding DataPermissionsSummary}"
                                           Style="{StaticResource BodySecondary}"
                                           TextWrapping="Wrap"
                                           Margin="0,7,0,0" />
                                <StackPanel Orientation="Horizontal"
                                            Margin="0,5,0,0">
                                    <TextBlock Text="CLI path: "
                                               Style="{StaticResource BodySecondary}" />
                                    <TextBlock Text="{Binding CliPathDisplay}"
                                               Style="{StaticResource BodySecondary}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}" Padding="0">
                            <StackPanel>
                                <TextBlock Text="Current Daily Universe"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Margin="18,16,18,12" />
                                <DataGrid ItemsSource="{Binding UniverseEntries}"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          CanUserResizeRows="False"
                                          HeadersVisibility="Column"
                                          GridLinesVisibility="Horizontal"
                                          Background="Transparent"
                                          Foreground="{StaticResource PrimaryTextBrush}"
                                          BorderThickness="0"
                                          RowBackground="#09000000"
                                          AlternatingRowBackground="#12FFFFFF"
                                          HorizontalGridLinesBrush="#18FFFFFF"
                                          MaxHeight="390">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Symbol"
                                                            Binding="{Binding Symbol}"
                                                            Width="105" />
                                        <DataGridTextColumn Header="Decision"
                                                            Binding="{Binding DispositionLabel}"
                                                            Width="105" />
                                        <DataGridTextColumn Header="Reason"
                                                            Binding="{Binding Reason}"
                                                            Width="*" />
                                        <DataGridTextColumn Header="Industry"
                                                            Binding="{Binding Industry}"
                                                            Width="155" />
                                        <DataGridTextColumn Header="Last"
                                                            Binding="{Binding LiquidityMetrics.LastPrice}"
                                                            Width="80" />
                                        <DataGridTextColumn Header="History"
                                                            Binding="{Binding DataCoverage.HistoryCoverageDays}"
                                                            Width="75" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="SettingsPanel"
                              Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="34,30,34,38">
                        <TextBlock Text="LOCAL DATA CONFIGURATION"
                                   Style="{StaticResource EyebrowText}" />
                        <TextBlock Text="Settings"
                                   Style="{StaticResource PageTitle}" />
                        <TextBlock Text="Only non-sensitive CLI and cache preferences are stored. Authorization stays inside the user-installed CLI."
                                   Style="{StaticResource BodySecondary}"
                                   Margin="0,0,0,22" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0"
                                    Style="{StaticResource CardBorder}"
                                    Margin="0,0,9,0">
                                <StackPanel>
                                    <TextBlock Text="Longbridge CLI"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,16" />
                                    <CheckBox Content="Use deterministic fixture mode"
                                              IsChecked="{Binding FixtureMode, Mode=TwoWay}"
                                              Margin="0,0,0,16" />
                                    <TextBlock Text="Executable path"
                                               FontSize="11"
                                               FontWeight="SemiBold" />
                                    <TextBox Text="{Binding CliExecutablePath, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                             Margin="0,6,0,14"
                                             ToolTip="Leave blank to resolve Longbridge from the system PATH." />
                                    <TextBlock Text="Default market"
                                               FontSize="11"
                                               FontWeight="SemiBold" />
                                    <TextBox Text="{Binding DefaultMarket, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                             Margin="0,6,0,14" />
                                    <TextBlock Text="No broker token, secret, or authorization code is requested or stored."
                                               Foreground="#FF54D38A"
                                               FontSize="11"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1"
                                    Style="{StaticResource CardBorder}"
                                    Margin="9,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="Cache and Retention"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,16" />
                                    <TextBlock Text="Cache directory"
                                               FontSize="11"
                                               FontWeight="SemiBold" />
                                    <TextBox Text="{Binding CacheDirectory, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                             Margin="0,6,0,16" />
                                    <TextBlock Text="{Binding ProcessTimeoutDisplay}"
                                               FontSize="11"
                                               FontWeight="SemiBold" />
                                    <Slider Minimum="2"
                                            Maximum="120"
                                            Value="{Binding ProcessTimeoutSeconds, Mode=TwoWay}"
                                            Margin="0,5,0,14" />
                                    <TextBlock Text="{Binding DataRetentionDisplay}"
                                               FontSize="11"
                                               FontWeight="SemiBold" />
                                    <Slider Minimum="7"
                                            Maximum="365"
                                            Value="{Binding DataRetentionDays, Mode=TwoWay}"
                                            Margin="0,5,0,14" />
                                    <TextBlock Text="{Binding LogRetentionDisplay}"
                                               FontSize="11"
                                               FontWeight="SemiBold" />
                                    <Slider Minimum="7"
                                            Maximum="180"
                                            Value="{Binding LogRetentionDays, Mode=TwoWay}"
                                            Margin="0,5,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Style="{StaticResource CardBorder}" Margin="0,18,0,0">
                            <StackPanel>
                                <TextBlock Text="Global Live Lock"
                                           FontSize="15"
                                           FontWeight="SemiBold" />
                                <CheckBox Content="Enable bounded Live mode selection"
                                          IsChecked="{Binding GlobalLiveLock, Mode=TwoWay}"
                                          Margin="0,12,0,0" />
                                <TextBlock Text="{Binding GlobalLiveLockStatus}"
                                           Style="{StaticResource BodySecondary}"
                                           TextWrapping="Wrap"
                                           Margin="0,6,0,0" />
                                <TextBlock Text="Live broker submission remains intentionally rejecting until v1.1.3 command verification."
                                           Foreground="#FFF7B955"
                                           FontSize="11"
                                           Margin="0,5,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}" Margin="0,18,0,0">
                            <TextBlock Text="{Binding FixtureModeStatus}"
                                       Style="{StaticResource BodySecondary}"
                                       TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="LogsPanel"
                              Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="34,30,34,38">
                        <TextBlock Text="STRUCTURED OPERATIONS"
                                   Style="{StaticResource EyebrowText}" />
                        <TextBlock Text="Logs"
                                   Style="{StaticResource PageTitle}" />
                        <TextBlock Text="CLI logs contain bounded outcomes and read-only categories, never raw authentication output."
                                   Style="{StaticResource BodySecondary}"
                                   Margin="0,0,0,22" />
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="180" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding LogSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Search message, module, strategy, correlation, or cycle." />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding LogSeverityOptions}"
                                      SelectedItem="{Binding SelectedLogSeverity, Mode=TwoWay}"
                                      Margin="12,0,0,0" />
                        </Grid>
                        <Border Style="{StaticResource CardBorder}" Padding="0">
                            <ListView ItemsSource="{Binding FilteredApplicationLogs}"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      Foreground="{StaticResource PrimaryTextBrush}"
                                      MaxHeight="560">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Time"
                                                        DisplayMemberBinding="{Binding Timestamp}"
                                                        Width="165" />
                                        <GridViewColumn Header="Severity"
                                                        DisplayMemberBinding="{Binding Severity}"
                                                        Width="80" />
                                        <GridViewColumn Header="Module"
                                                        DisplayMemberBinding="{Binding Module}"
                                                        Width="120" />
                                        <GridViewColumn Header="Strategy"
                                                        DisplayMemberBinding="{Binding StrategyId}"
                                                        Width="150" />
                                        <GridViewColumn Header="Correlation"
                                                        DisplayMemberBinding="{Binding CorrelationId}"
                                                        Width="150" />
                                        <GridViewColumn Header="Cycle"
                                                        DisplayMemberBinding="{Binding CycleId}"
                                                        Width="130" />
                                        <GridViewColumn Header="Message"
                                                        DisplayMemberBinding="{Binding Message}"
                                                        Width="360" />
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="PrivacyPanel"
                              Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="34,30,34,38">
                        <TextBlock Text="PRIVACY BY DESIGN"
                                   Style="{StaticResource EyebrowText}" />
                        <TextBlock Text="Sanitized and self-contained"
                                   Style="{StaticResource PageTitle}" />
                        <TextBlock Text="The release contains no production account or personal data."
                                   Style="{StaticResource BodySecondary}"
                                   Margin="0,0,0,22" />

                        <UniformGrid Columns="3" Margin="0,0,0,18">
                            <Border Style="{StaticResource CardBorder}" Margin="0,0,11,0">
                                <StackPanel>
                                    <Border Width="36"
                                            Height="36"
                                            Background="#1855D7F1"
                                            CornerRadius="11"
                                            HorizontalAlignment="Left">
                                        <TextBlock Text="NET"
                                                   Foreground="{StaticResource AccentBrush}"
                                                   FontSize="9"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="Fixture Mode Offline"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Margin="0,15,0,6" />
                                    <TextBlock Text="Local CLI mode delegates read-only data access to the user-installed CLI"
                                               Style="{StaticResource BodySecondary}"
                                               FontSize="10" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardBorder}" Margin="5,0,5,0">
                                <StackPanel>
                                    <Border Width="36"
                                            Height="36"
                                            Background="#18A68BFA"
                                            CornerRadius="11"
                                            HorizontalAlignment="Left">
                                        <TextBlock Text="ID"
                                                   Foreground="{StaticResource PurpleBrush}"
                                                   FontSize="9"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="No Identity Data"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Margin="0,15,0,6" />
                                    <TextBlock Text="No account numbers, user names, or device identifiers"
                                               Style="{StaticResource BodySecondary}"
                                               FontSize="10" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardBorder}" Margin="11,0,0,0">
                                <StackPanel>
                                    <Border Width="36"
                                            Height="36"
                                            Background="#1854D38A"
                                            CornerRadius="11"
                                            HorizontalAlignment="Left">
                                        <TextBlock Text="KEY"
                                                   Foreground="#FF54D38A"
                                                   FontSize="9"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="No Secrets"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Margin="0,15,0,6" />
                                    <TextBlock Text="No tokens, certificates, or environment variables"
                                               Style="{StaticResource BodySecondary}"
                                               FontSize="10" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="Release Boundary"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,17" />

                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="88" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="INCLUDES"
                                               Foreground="{StaticResource AccentBrush}"
                                               FontSize="10"
                                               FontWeight="Bold" />
                                    <TextBlock Grid.Column="1"
                                               Text="Native UI, Local Paper execution records, fixture data, local cache, and daily universe decisions"
                                               Style="{StaticResource BodySecondary}" />
                                </Grid>

                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="88" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="EXCLUDES"
                                               Foreground="{StaticResource AccentBrush}"
                                               FontSize="10"
                                               FontWeight="Bold" />
                                    <TextBlock Grid.Column="1"
                                               Text="Broker credentials, real broker submission, real orders, account profit and loss, and account bindings"
                                               Style="{StaticResource BodySecondary}" />
                                </Grid>

                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="88" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="STORAGE"
                                               Foreground="{StaticResource AccentBrush}"
                                               FontSize="10"
                                               FontWeight="Bold" />
                                    <TextBlock Grid.Column="1"
                                               Text="Non-sensitive settings, Local Paper ledger, market cache, logs, and audit data stay local"
                                               Style="{StaticResource BodySecondary}" />
                                </Grid>

                                <Grid Margin="0,0,0,17">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="88" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="TRADING"
                                               Foreground="{StaticResource AccentBrush}"
                                               FontSize="10"
                                               FontWeight="Bold" />
                                    <TextBlock Grid.Column="1"
                                               Text="Local Paper only. Live submission is rejecting and no real broker process is started"
                                               Style="{StaticResource BodySecondary}" />
                                </Grid>

                                <Border Height="1" Background="#22FFFFFF" Margin="0,0,0,15" />
                                <TextBlock Text="Suitable for demos, reviews, and UI prototyping. Not investment advice."
                                           Foreground="#FF54D38A"
                                           FontSize="12"
                                           FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>
