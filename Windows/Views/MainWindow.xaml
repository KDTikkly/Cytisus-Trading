<Window x:Class="CytisusTrading.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cytisus-Trading"
        Width="1280"
        Height="820"
        MinWidth="1120"
        MinHeight="720"
        Icon="/Resources/ProductIcon.ico"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource PrimaryTextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        UseLayoutRounding="True">
    <Grid ClipToBounds="True">
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FF07101F" Offset="0" />
                <GradientStop Color="#FF16102C" Offset="0.55" />
                <GradientStop Color="#FF061A25" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>

        <Ellipse Width="620"
                 Height="620"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Top"
                 Margin="0,-310,-250,0"
                 IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#5038BEDD" Offset="0" />
                    <GradientStop Color="#0038BEDD" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <Ellipse Width="720"
                 Height="720"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Bottom"
                 Margin="-350,0,0,-430"
                 IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#504F36B8" Offset="0" />
                    <GradientStop Color="#004F36B8" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="258" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="#B30A1220"
                    BorderBrush="#243F526D"
                    BorderThickness="0,0,1,0">
                <Grid Margin="18,28,18,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="4,0,0,28">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="48" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="46"
                                Height="46"
                                CornerRadius="13"
                                BorderBrush="#506E7FA3"
                                BorderThickness="1"
                                Background="#FF050B1C">
                            <Image Source="/Resources/ProductLogo.png"
                                   Stretch="UniformToFill"
                                   Margin="1" />
                        </Border>
                        <StackPanel Grid.Column="1"
                                    Margin="12,3,0,0"
                                    VerticalAlignment="Top">
                            <TextBlock Text="Cytisus-Trading"
                                       FontWeight="SemiBold"
                                       FontSize="15" />
                            <TextBlock Text="v1.1 Automated Operations"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       FontSize="11"
                                       Margin="0,3,0,0" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="1">
                        <Button x:Name="OverviewNav"
                                Tag="Overview"
                                Style="{StaticResource NavButton}"
                                Click="NavButton_Click"
                                Margin="0,0,0,5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="24"
                                        Height="24"
                                        CornerRadius="7"
                                        Background="#1855D7F1"
                                        HorizontalAlignment="Left">
                                    <TextBlock Text="01"
                                               Foreground="{StaticResource AccentBrush}"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Grid.Column="1"
                                           Text="Dashboard"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Button>

                        <Button x:Name="FactorsNav"
                                Tag="Factors"
                                Style="{StaticResource NavButton}"
                                Click="NavButton_Click"
                                Margin="0,0,0,5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="24"
                                        Height="24"
                                        CornerRadius="7"
                                        Background="#18A68BFA"
                                        HorizontalAlignment="Left">
                                    <TextBlock Text="02"
                                               Foreground="{StaticResource PurpleBrush}"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Grid.Column="1"
                                           Text="Factor Lifecycle"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Button>

                        <Button x:Name="LabNav"
                                Tag="Lab"
                                Style="{StaticResource NavButton}"
                                Click="NavButton_Click"
                                Margin="0,0,0,5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="24"
                                        Height="24"
                                        CornerRadius="7"
                                        Background="#18F7B955"
                                        HorizontalAlignment="Left">
                                    <TextBlock Text="03"
                                               Foreground="#FFF7B955"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Grid.Column="1"
                                           Text="Strategies"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Button>

                        <Button x:Name="PortfolioNav"
                                Tag="Portfolio"
                                Style="{StaticResource NavButton}"
                                Click="NavButton_Click"
                                Margin="0,0,0,5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="24"
                                        Height="24"
                                        CornerRadius="7"
                                        Background="#1854D38A"
                                        HorizontalAlignment="Left">
                                    <TextBlock Text="04"
                                               Foreground="#FF54D38A"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Grid.Column="1"
                                           Text="Portfolio"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Button>

                        <Button x:Name="ExecutionNav"
                                Tag="Execution"
                                Style="{StaticResource NavButton}"
                                Click="NavButton_Click"
                                Margin="0,0,0,5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="24"
                                        Height="24"
                                        CornerRadius="7"
                                        Background="#18A68BFA"
                                        HorizontalAlignment="Left">
                                    <TextBlock Text="05"
                                               Foreground="{StaticResource PurpleBrush}"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Grid.Column="1"
                                           Text="Execution"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Button>

                        <Button x:Name="DataNav"
                                Tag="Data"
                                Style="{StaticResource NavButton}"
                                Click="NavButton_Click"
                                Margin="0,0,0,5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="24"
                                        Height="24"
                                        CornerRadius="7"
                                        Background="#1855D7F1"
                                        HorizontalAlignment="Left">
                                    <TextBlock Text="06"
                                               Foreground="{StaticResource AccentBrush}"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Grid.Column="1"
                                           Text="Data and Universe"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Button>

                        <Button x:Name="SettingsNav"
                                Tag="Settings"
                                Style="{StaticResource NavButton}"
                                Click="NavButton_Click"
                                Margin="0,0,0,5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="24"
                                        Height="24"
                                        CornerRadius="7"
                                        Background="#18F7B955"
                                        HorizontalAlignment="Left">
                                    <TextBlock Text="07"
                                               Foreground="#FFF7B955"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Grid.Column="1"
                                           Text="Settings"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Button>

                        <Button x:Name="LogsNav"
                                Tag="Logs"
                                Style="{StaticResource NavButton}"
                                Click="NavButton_Click"
                                Margin="0,0,0,5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="24"
                                        Height="24"
                                        CornerRadius="7"
                                        Background="#18A68BFA"
                                        HorizontalAlignment="Left">
                                    <TextBlock Text="08"
                                               Foreground="{StaticResource PurpleBrush}"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Grid.Column="1"
                                           Text="Logs"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Button>

                        <Button x:Name="PrivacyNav"
                                Tag="Privacy"
                                Style="{StaticResource NavButton}"
                                Click="NavButton_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="24"
                                        Height="24"
                                        CornerRadius="7"
                                        Background="#1854D38A"
                                        HorizontalAlignment="Left">
                                    <TextBlock Text="09"
                                               Foreground="#FF54D38A"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Grid.Column="1"
                                           Text="Privacy and Sanitization"
                                           FontSize="12"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                    </StackPanel>

                    <Border Grid.Row="3"
                            Background="#0FFFFFFF"
                            BorderBrush="#244D6380"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="13">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8"
                                         Height="8"
                                         Fill="#FF54D38A"
                                         Margin="0,0,8,0"
                                         VerticalAlignment="Center" />
                                <TextBlock Text="Data Mode"
                                           Foreground="#FF54D38A"
                                           FontSize="11"
                                           FontWeight="SemiBold" />
                            </StackPanel>
                            <TextBlock Text="{Binding FixtureModeStatus}"
                                       Style="{StaticResource BodySecondary}"
                                       FontSize="10"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Column="1">
                <ScrollViewer x:Name="OverviewPanel"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="34,30,34,38">
                        <Grid Margin="0,0,0,22">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="AUTOMATED OPERATIONS"
                                           Style="{StaticResource EyebrowText}" />
                                <TextBlock Text="Dashboard"
                                           Style="{StaticResource PageTitle}" />
                                <TextBlock Text="Strategy runtime health, bounded modes, and deterministic Local Paper activity. Live broker submission is unavailable."
                                           Style="{StaticResource BodySecondary}" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Content="Run Paper Cycle"
                                    Style="{StaticResource PrimaryButton}"
                                    Click="RunPaperCycle_Click"
                                    VerticalAlignment="Bottom"
                                    Margin="24,0,0,2" />
                        </Grid>

                        <UniformGrid Columns="4" Margin="0,0,0,18">
                            <Border Style="{StaticResource CardBorder}" Margin="0,0,12,0">
                                <StackPanel>
                                    <TextBlock Text="LOCAL PAPER STRATEGIES"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               FontSize="10"
                                               FontWeight="Bold" />
                                    <TextBlock Text="{Binding PaperStrategyCount}"
                                               FontSize="24"
                                               FontWeight="SemiBold"
                                               Margin="0,12,0,4" />
                                    <TextBlock Text="Safe default"
                                               Style="{StaticResource BodySecondary}"
                                               FontSize="11" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardBorder}" Margin="4,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="LIVE SELECTED"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               FontSize="10"
                                               FontWeight="Bold" />
                                    <TextBlock Text="{Binding LiveStrategyCount}"
                                               FontSize="24"
                                               FontWeight="SemiBold"
                                               Margin="0,12,0,4" />
                                    <TextBlock Text="Submission disabled"
                                               Style="{StaticResource BodySecondary}"
                                               FontSize="11" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardBorder}" Margin="8,0,4,0">
                                <StackPanel>
                                    <TextBlock Text="HEALTHY RUNTIMES"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               FontSize="10"
                                               FontWeight="Bold" />
                                    <TextBlock Text="{Binding HealthyStrategyCount}"
                                               FontSize="24"
                                               FontWeight="SemiBold"
                                               Margin="0,12,0,4" />
                                    <TextBlock Text="Heartbeat observed"
                                               Style="{StaticResource BodySecondary}"
                                               FontSize="11" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardBorder}" Margin="12,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="GLOBAL LIVE LOCK"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               FontSize="10"
                                               FontWeight="Bold" />
                                    <TextBlock Text="{Binding GlobalLiveLockLabel}"
                                               FontSize="24"
                                               FontWeight="SemiBold"
                                               Margin="0,12,0,4" />
                                    <TextBlock Text="OFF by default"
                                               Style="{StaticResource BodySecondary}"
                                               FontSize="11" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <UniformGrid Columns="4" Margin="0,0,0,18">
                            <Border Style="{StaticResource CardBorder}" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="REGIME: TREND"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               FontSize="10"
                                               FontWeight="Bold" />
                                    <TextBlock Text="{Binding TrendProbability}"
                                               FontSize="22"
                                               FontWeight="SemiBold"
                                               Margin="0,10,0,3" />
                                    <TextBlock Text="{Binding RegimeUncertainty, StringFormat=Uncertainty {0}}"
                                               Style="{StaticResource BodySecondary}"
                                               FontSize="10" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardBorder}" Margin="3,0,7,0">
                                <StackPanel>
                                    <TextBlock Text="REGIME: RANGE"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               FontSize="10"
                                               FontWeight="Bold" />
                                    <TextBlock Text="{Binding RangeProbability}"
                                               FontSize="22"
                                               FontWeight="SemiBold"
                                               Margin="0,10,0,3" />
                                    <TextBlock Text="Probabilistic ensemble"
                                               Style="{StaticResource BodySecondary}"
                                               FontSize="10" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardBorder}" Margin="7,0,3,0">
                                <StackPanel>
                                    <TextBlock Text="REGIME: HIGH VOL"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               FontSize="10"
                                               FontWeight="Bold" />
                                    <TextBlock Text="{Binding HighVolatilityProbability}"
                                               FontSize="22"
                                               FontWeight="SemiBold"
                                               Margin="0,10,0,3" />
                                    <TextBlock Text="Risk contraction input"
                                               Style="{StaticResource BodySecondary}"
                                               FontSize="10" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardBorder}" Margin="10,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="REGIME: CRISIS"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               FontSize="10"
                                               FontWeight="Bold" />
                                    <TextBlock Text="{Binding CrisisProbability}"
                                               FontSize="22"
                                               FontWeight="SemiBold"
                                               Margin="0,10,0,3" />
                                    <TextBlock Text="{Binding PortfolioRiskDisplay, StringFormat=Risk multiplier {0}}"
                                               Style="{StaticResource BodySecondary}"
                                               FontSize="10" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Border Style="{StaticResource CardBorder}"
                                Margin="0,0,0,18">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="Dynamic Capital Allocator"
                                               FontSize="14"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding AllocatorSummary}"
                                               Style="{StaticResource BodySecondary}"
                                               TextWrapping="Wrap"
                                               Margin="0,5,0,0" />
                                </StackPanel>
                                <TextBlock Text="{Binding CapitalUsageDisplay}"
                                           Foreground="#FF54D38A"
                                           FontSize="22"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="320" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Style="{StaticResource CardBorder}"
                                    Margin="0,0,16,0">
                                <StackPanel>
                                    <Grid>
                                        <StackPanel>
                                            <TextBlock Text="Sample Strategy Path"
                                                       FontSize="15"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="Normalized research curve | Not actual returns"
                                                       Style="{StaticResource BodySecondary}"
                                                       FontSize="11"
                                                       Margin="0,4,0,0" />
                                        </StackPanel>
                                        <TextBlock Text="+6.8%"
                                                   Foreground="#FF54D38A"
                                                   FontSize="19"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Right" />
                                    </Grid>

                                    <Grid Height="190" Margin="0,18,0,10">
                                        <Grid.RowDefinitions>
                                            <RowDefinition />
                                            <RowDefinition />
                                            <RowDefinition />
                                            <RowDefinition />
                                        </Grid.RowDefinitions>
                                        <Rectangle Grid.Row="0" Fill="#10FFFFFF" Margin="0,0,0,1" />
                                        <Rectangle Grid.Row="1" Fill="#0AFFFFFF" Margin="0,0,0,1" />
                                        <Rectangle Grid.Row="2" Fill="#10FFFFFF" Margin="0,0,0,1" />
                                        <Rectangle Grid.Row="3" Fill="#0AFFFFFF" />
                                        <Viewbox Grid.RowSpan="4" Stretch="Fill" Margin="2,8">
                                            <Canvas Width="780" Height="170">
                                                <Polygon Points="0,152 70,142 140,148 210,124 280,130 350,101 420,112 490,80 560,87 630,52 700,61 780,24 780,170 0,170"
                                                         Fill="#2255D7F1" />
                                                <Polyline Points="0,152 70,142 140,148 210,124 280,130 350,101 420,112 490,80 560,87 630,52 700,61 780,24"
                                                          Stroke="#FF55D7F1"
                                                          StrokeThickness="4"
                                                          StrokeLineJoin="Round" />
                                            </Canvas>
                                        </Viewbox>
                                    </Grid>

                                    <Grid>
                                        <TextBlock Text="No real positions"
                                                   Style="{StaticResource BodySecondary}"
                                                   FontSize="11" />
                                        <TextBlock Text="Demo period: 12 sample windows"
                                                   Style="{StaticResource BodySecondary}"
                                                   FontSize="11"
                                                   HorizontalAlignment="Right" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <TextBlock Text="Governance Summary"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,14" />

                                    <Grid Margin="0,0,0,13">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Width="8"
                                                 Height="8"
                                                 Fill="#FF54D38A"
                                                 VerticalAlignment="Top"
                                                 Margin="0,5,0,0" />
                                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                            <TextBlock Text="Admission" FontWeight="SemiBold" FontSize="12" />
                                            <TextBlock Text="Pass the OOS gate twice in sequence"
                                                       Style="{StaticResource BodySecondary}"
                                                       FontSize="10" />
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,0,0,13">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Width="8"
                                                 Height="8"
                                                 Fill="#FFF7B955"
                                                 VerticalAlignment="Top"
                                                 Margin="0,5,0,0" />
                                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                            <TextBlock Text="Downgrade" FontWeight="SemiBold" FontSize="12" />
                                            <TextBlock Text="Two failures trigger probation"
                                                       Style="{StaticResource BodySecondary}"
                                                       FontSize="10" />
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,0,0,13">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Width="8"
                                                 Height="8"
                                                 Fill="#FF9AA8BC"
                                                 VerticalAlignment="Top"
                                                 Margin="0,5,0,0" />
                                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                            <TextBlock Text="Retirement" FontWeight="SemiBold" FontSize="12" />
                                            <TextBlock Text="Three failures and a 126-day cooldown"
                                                       Style="{StaticResource BodySecondary}"
                                                       FontSize="10" />
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Width="8"
                                                 Height="8"
                                                 Fill="#FFFF6E80"
                                                 VerticalAlignment="Top"
                                                 Margin="0,5,0,0" />
                                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                            <TextBlock Text="Quarantine" FontWeight="SemiBold" FontSize="12" />
                                            <TextBlock Text="Stop on look-ahead or source contamination"
                                                       Style="{StaticResource BodySecondary}"
                                                       FontSize="10" />
                                        </StackPanel>
                                    </Grid>

                                    <Border Height="1" Background="#22FFFFFF" Margin="0,0,0,13" />
                                    <TextBlock Text="Return targets never influence factor promotion."
                                               Foreground="{StaticResource AccentBrush}"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Border Style="{StaticResource CardBorder}"
                                Margin="0,18,0,0">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="Latest Strategy Cycle"
                                               FontSize="14"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding LatestCycleDisplay}"
                                               Style="{StaticResource BodySecondary}"
                                               Margin="0,5,0,0" />
                                </StackPanel>
                                <TextBlock Text="{Binding LatestStrategyAlert}"
                                           Foreground="#FFF7B955"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           HorizontalAlignment="Right"
                                           MaxWidth="520" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="FactorsPanel"
                              Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="34,30,34,38">
                        <Grid Margin="0,0,0,22">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="FACTOR GOVERNANCE"
                                           Style="{StaticResource EyebrowText}" />
                                <TextBlock Text="Factor Lifecycle"
                                           Style="{StaticResource PageTitle}" />
                                <TextBlock Text="Multi-task evidence, deterministic candidate search, strategy-level state, and global safety governance."
                                           Style="{StaticResource BodySecondary}" />
