<Window x:Class="CytisusTrading.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cytisus-Trading"
        Width="1280"
        Height="820"
        MinWidth="1120"
        MinHeight="720"
        Icon="Resources/ProductIcon.ico"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource PrimaryTextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        UseLayoutRounding="True">
    <Grid ClipToBounds="True">
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FF07101F" Offset="0" />
                <GradientStop Color="#FF16102C" Offset="0.55" />
                <GradientStop Color="#FF061A25" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>

        <Ellipse Width="620"
                 Height="620"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Top"
                 Margin="0,-310,-250,0"
                 IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#5038BEDD" Offset="0" />
                    <GradientStop Color="#0038BEDD" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <Ellipse Width="720"
                 Height="720"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Bottom"
                 Margin="-350,0,0,-430"
                 IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#504F36B8" Offset="0" />
                    <GradientStop Color="#004F36B8" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="258" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="#B30A1220"
                    BorderBrush="#243F526D"
                    BorderThickness="0,0,1,0">
                <Grid Margin="18,28,18,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="4,0,0,28">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="48" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="46"
                                Height="46"
                                CornerRadius="13"
                                BorderBrush="#506E7FA3"
                                BorderThickness="1"
                                Background="#FF050B1C">
                            <Image Source="Resources/ProductLogo.png"
                                   Stretch="UniformToFill"
                                   Margin="1" />
                        </Border>
                        <StackPanel Grid.Column="1"
                                    Margin="12,3,0,0"
                                    VerticalAlignment="Top">
                            <TextBlock Text="Cytisus-Trading"
                                       FontWeight="SemiBold"
                                       FontSize="15" />
                            <TextBlock Text="Offline Factor Lab"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       FontSize="11"
                                       Margin="0,3,0,0" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="1">
                        <Button x:Name="OverviewNav"
                                Tag="Overview"
                                Style="{StaticResource NavButton}"
                                Click="NavButton_Click"
                                Margin="0,0,0,5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="24"
                                        Height="24"
                                        CornerRadius="7"
                                        Background="#1855D7F1"
                                        HorizontalAlignment="Left">
                                    <TextBlock Text="01"
                                               Foreground="{StaticResource AccentBrush}"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Grid.Column="1"
                                           Text="Overview"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Button>

                        <Button x:Name="FactorsNav"
                                Tag="Factors"
                                Style="{StaticResource NavButton}"
                                Click="NavButton_Click"
                                Margin="0,0,0,5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="24"
                                        Height="24"
                                        CornerRadius="7"
                                        Background="#18A68BFA"
                                        HorizontalAlignment="Left">
                                    <TextBlock Text="02"
                                               Foreground="{StaticResource PurpleBrush}"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Grid.Column="1"
                                           Text="Factor Lifecycle"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Button>

                        <Button x:Name="LabNav"
                                Tag="Lab"
                                Style="{StaticResource NavButton}"
                                Click="NavButton_Click"
                                Margin="0,0,0,5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="24"
                                        Height="24"
                                        CornerRadius="7"
                                        Background="#18F7B955"
                                        HorizontalAlignment="Left">
                                    <TextBlock Text="03"
                                               Foreground="#FFF7B955"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Grid.Column="1"
                                           Text="Strategy Lab"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Button>

                        <Button x:Name="PrivacyNav"
                                Tag="Privacy"
                                Style="{StaticResource NavButton}"
                                Click="NavButton_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="24"
                                        Height="24"
                                        CornerRadius="7"
                                        Background="#1854D38A"
                                        HorizontalAlignment="Left">
                                    <TextBlock Text="04"
                                               Foreground="#FF54D38A"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Grid.Column="1"
                                           Text="Privacy and Sanitization"
                                           FontSize="12"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                    </StackPanel>

                    <Border Grid.Row="3"
                            Background="#0FFFFFFF"
                            BorderBrush="#244D6380"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="13">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8"
                                         Height="8"
                                         Fill="#FF54D38A"
                                         Margin="0,0,8,0"
                                         VerticalAlignment="Center" />
                                <TextBlock Text="Local Demo Mode"
                                           Foreground="#FF54D38A"
                                           FontSize="11"
                                           FontWeight="SemiBold" />
                            </StackPanel>
                            <TextBlock Text="No network | No accounts | No real orders"
                                       Style="{StaticResource BodySecondary}"
                                       FontSize="10"
                                       Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Column="1">
                <ScrollViewer x:Name="OverviewPanel"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="34,30,34,38">
                        <Grid Margin="0,0,0,22">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="RESEARCH WORKSPACE"
                                           Style="{StaticResource EyebrowText}" />
                                <TextBlock Text="Strategy status at a glance"
                                           Style="{StaticResource PageTitle}" />
                                <TextBlock Text="Sanitized sample data demonstrates the factor governance workflow."
                                           Style="{StaticResource BodySecondary}" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Content="Run Sample Review"
                                    Style="{StaticResource PrimaryButton}"
                                    Click="RunReview_Click"
                                    VerticalAlignment="Bottom"
                                    Margin="24,0,0,2" />
                        </Grid>

                        <UniformGrid Columns="4" Margin="0,0,0,18">
                            <Border Style="{StaticResource CardBorder}" Margin="0,0,12,0">
                                <StackPanel>
                                    <TextBlock Text="RUN MODE"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               FontSize="10"
                                               FontWeight="Bold" />
                                    <TextBlock Text="Offline"
                                               FontSize="24"
                                               FontWeight="SemiBold"
                                               Margin="0,12,0,4" />
                                    <TextBlock Text="No account connections"
                                               Style="{StaticResource BodySecondary}"
                                               FontSize="11" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardBorder}" Margin="4,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="ACTIVE FACTORS"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               FontSize="10"
                                               FontWeight="Bold" />
                                    <TextBlock Text="{Binding ActiveFactorCount}"
                                               FontSize="24"
                                               FontWeight="SemiBold"
                                               Margin="0,12,0,4" />
                                    <TextBlock Text="Independent risk gates"
                                               Style="{StaticResource BodySecondary}"
                                               FontSize="11" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardBorder}" Margin="8,0,4,0">
                                <StackPanel>
                                    <TextBlock Text="WEIGHTED COVERAGE"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               FontSize="10"
                                               FontWeight="Bold" />
                                    <TextBlock Text="{Binding WeightedCoverage}"
                                               FontSize="24"
                                               FontWeight="SemiBold"
                                               Margin="0,12,0,4" />
                                    <TextBlock Text="Minimum gate: 80%"
                                               Style="{StaticResource BodySecondary}"
                                               FontSize="11" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardBorder}" Margin="12,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="SHADOW QUEUE"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               FontSize="10"
                                               FontWeight="Bold" />
                                    <TextBlock Text="{Binding ShadowQueueCount}"
                                               FontSize="24"
                                               FontWeight="SemiBold"
                                               Margin="0,12,0,4" />
                                    <TextBlock Text="Awaiting OOS evidence"
                                               Style="{StaticResource BodySecondary}"
                                               FontSize="11" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="320" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Style="{StaticResource CardBorder}"
                                    Margin="0,0,16,0">
                                <StackPanel>
                                    <Grid>
                                        <StackPanel>
                                            <TextBlock Text="Sample Strategy Path"
                                                       FontSize="15"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="Normalized research curve | Not actual returns"
                                                       Style="{StaticResource BodySecondary}"
                                                       FontSize="11"
                                                       Margin="0,4,0,0" />
                                        </StackPanel>
                                        <TextBlock Text="+6.8%"
                                                   Foreground="#FF54D38A"
                                                   FontSize="19"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Right" />
                                    </Grid>

                                    <Grid Height="190" Margin="0,18,0,10">
                                        <Grid.RowDefinitions>
                                            <RowDefinition />
                                            <RowDefinition />
                                            <RowDefinition />
                                            <RowDefinition />
                                        </Grid.RowDefinitions>
                                        <Rectangle Grid.Row="0" Fill="#10FFFFFF" Margin="0,0,0,1" />
                                        <Rectangle Grid.Row="1" Fill="#0AFFFFFF" Margin="0,0,0,1" />
                                        <Rectangle Grid.Row="2" Fill="#10FFFFFF" Margin="0,0,0,1" />
                                        <Rectangle Grid.Row="3" Fill="#0AFFFFFF" />
                                        <Viewbox Grid.RowSpan="4" Stretch="Fill" Margin="2,8">
                                            <Canvas Width="780" Height="170">
                                                <Polygon Points="0,152 70,142 140,148 210,124 280,130 350,101 420,112 490,80 560,87 630,52 700,61 780,24 780,170 0,170"
                                                         Fill="#2255D7F1" />
                                                <Polyline Points="0,152 70,142 140,148 210,124 280,130 350,101 420,112 490,80 560,87 630,52 700,61 780,24"
                                                          Stroke="#FF55D7F1"
                                                          StrokeThickness="4"
                                                          StrokeLineJoin="Round" />
                                            </Canvas>
                                        </Viewbox>
                                    </Grid>

                                    <Grid>
                                        <TextBlock Text="No real positions"
                                                   Style="{StaticResource BodySecondary}"
                                                   FontSize="11" />
                                        <TextBlock Text="Demo period: 12 sample windows"
                                                   Style="{StaticResource BodySecondary}"
                                                   FontSize="11"
                                                   HorizontalAlignment="Right" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <TextBlock Text="Governance Summary"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,14" />

                                    <Grid Margin="0,0,0,13">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Width="8"
                                                 Height="8"
                                                 Fill="#FF54D38A"
                                                 VerticalAlignment="Top"
                                                 Margin="0,5,0,0" />
                                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                            <TextBlock Text="Admission" FontWeight="SemiBold" FontSize="12" />
                                            <TextBlock Text="Pass the OOS gate twice in sequence"
                                                       Style="{StaticResource BodySecondary}"
                                                       FontSize="10" />
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,0,0,13">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Width="8"
                                                 Height="8"
                                                 Fill="#FFF7B955"
                                                 VerticalAlignment="Top"
                                                 Margin="0,5,0,0" />
                                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                            <TextBlock Text="Downgrade" FontWeight="SemiBold" FontSize="12" />
                                            <TextBlock Text="Two failures trigger probation"
                                                       Style="{StaticResource BodySecondary}"
                                                       FontSize="10" />
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,0,0,13">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Width="8"
                                                 Height="8"
                                                 Fill="#FF9AA8BC"
                                                 VerticalAlignment="Top"
                                                 Margin="0,5,0,0" />
                                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                            <TextBlock Text="Retirement" FontWeight="SemiBold" FontSize="12" />
                                            <TextBlock Text="Three failures and a 126-day cooldown"
                                                       Style="{StaticResource BodySecondary}"
                                                       FontSize="10" />
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Width="8"
                                                 Height="8"
                                                 Fill="#FFFF6E80"
                                                 VerticalAlignment="Top"
                                                 Margin="0,5,0,0" />
                                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                            <TextBlock Text="Quarantine" FontWeight="SemiBold" FontSize="12" />
                                            <TextBlock Text="Stop on look-ahead or source contamination"
                                                       Style="{StaticResource BodySecondary}"
                                                       FontSize="10" />
                                        </StackPanel>
                                    </Grid>

                                    <Border Height="1" Background="#22FFFFFF" Margin="0,0,0,13" />
                                    <TextBlock Text="Return targets never influence factor promotion."
                                               Foreground="{StaticResource AccentBrush}"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="FactorsPanel"
                              Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="34,30,34,38">
                        <Grid Margin="0,0,0,22">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="FACTOR GOVERNANCE"
                                           Style="{StaticResource EyebrowText}" />
                                <TextBlock Text="Factor Lifecycle"
                                           Style="{StaticResource PageTitle}" />
                                <TextBlock Text="Use frozen out-of-sample evidence to control admission, downgrade, and retirement."
                                           Style="{StaticResource BodySecondary}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Bottom"
                                        Margin="20,0,0,2">
                                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="{Binding LastReviewLabel}"
                                               Style="{StaticResource BodySecondary}"
                                               FontSize="10"
                                               HorizontalAlignment="Right" />
                                </StackPanel>
                                <Button Content="Reset"
                                        Style="{StaticResource SecondaryButton}"
                                        Click="Reset_Click"
                                        Margin="0,0,9,0" />
                                <Button Content="Generate Review Proposal"
                                        Style="{StaticResource PrimaryButton}"
                                        Click="RunReview_Click" />
                            </StackPanel>
                        </Grid>

                        <Border Style="{StaticResource CardBorder}" Padding="0">
                            <StackPanel>
                                <Grid Margin="18,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="50" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="FACTOR"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               FontSize="10"
                                               FontWeight="Bold" />
                                    <TextBlock Grid.Column="1"
                                               Text="STATE"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               FontSize="10"
                                               FontWeight="Bold" />
                                    <TextBlock Grid.Column="2"
                                               Text="IC"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="3"
                                               Text="IR"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="4"
                                               Text="COVERAGE"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="5"
                                               Text="WEIGHT"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="6"
                                               Text="OOS"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Right" />
                                </Grid>

                                <Border Height="1" Background="#20FFFFFF" />

                                <ItemsControl ItemsSource="{Binding Factors}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#16FFFFFF"
                                                    BorderThickness="0,0,0,1"
                                                    Padding="18,12">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="120" />
                                                        <ColumnDefinition Width="60" />
                                                        <ColumnDefinition Width="60" />
                                                        <ColumnDefinition Width="80" />
                                                        <ColumnDefinition Width="70" />
                                                        <ColumnDefinition Width="50" />
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Name}"
                                                                       FontSize="12"
                                                                       FontWeight="SemiBold"
                                                                       VerticalAlignment="Center" />
                                                            <Border Background="#1855D7F1"
                                                                    CornerRadius="6"
                                                                    Padding="6,2"
                                                                    Margin="8,0,0,0">
                                                                <TextBlock Text="{Binding Category}"
                                                                           Foreground="{StaticResource AccentBrush}"
                                                                           FontSize="9"
                                                                           FontWeight="SemiBold" />
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Reason}"
                                                                   Style="{StaticResource BodySecondary}"
                                                                   FontSize="10"
                                                                   Margin="0,5,12,0"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   TextWrapping="NoWrap" />
                                                    </StackPanel>

                                                    <Border Grid.Column="1"
                                                            Background="{Binding StateBackground}"
                                                            BorderBrush="{Binding StateBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="10"
                                                            Padding="8,4"
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Ellipse Width="6"
                                                                     Height="6"
                                                                     Fill="{Binding StateBrush}"
                                                                     Margin="0,0,6,0"
                                                                     VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding StateLabel}"
                                                                       Foreground="{Binding StateBrush}"
                                                                       FontSize="10"
                                                                       FontWeight="SemiBold" />
                                                        </StackPanel>
                                                    </Border>

                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding IcDisplay}"
                                                               FontFamily="Cascadia Mono, Consolas"
                                                               FontSize="11"
                                                               HorizontalAlignment="Right"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="3"
                                                               Text="{Binding IrDisplay}"
                                                               FontFamily="Cascadia Mono, Consolas"
                                                               FontSize="11"
                                                               HorizontalAlignment="Right"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="4"
                                                               Text="{Binding CoverageDisplay}"
                                                               FontFamily="Cascadia Mono, Consolas"
                                                               FontSize="11"
                                                               HorizontalAlignment="Right"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="5"
                                                               Text="{Binding WeightDisplay}"
                                                               FontFamily="Cascadia Mono, Consolas"
                                                               FontSize="11"
                                                               HorizontalAlignment="Right"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="6"
                                                               Text="{Binding EvidenceWindows}"
                                                               FontFamily="Cascadia Mono, Consolas"
                                                               FontSize="11"
                                                               HorizontalAlignment="Right"
                                                               VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Run the proposal twice to promote the shadow factor and retire the weak factor. Changes remain in local memory."
                                   Style="{StaticResource BodySecondary}"
                                   FontSize="11"
                                   Margin="4,15,0,0" />
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="LabPanel"
                              Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="34,30,34,38">
                        <TextBlock Text="POLICY LAB"
                                   Style="{StaticResource EyebrowText}" />
                        <TextBlock Text="Strategy Lab"
                                   Style="{StaticResource PageTitle}" />
                        <TextBlock Text="Adjust demo thresholds and observe how governance rules constrain factors."
                                   Style="{StaticResource BodySecondary}"
                                   Margin="0,0,0,22" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="370" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Style="{StaticResource CardBorder}"
                                    Margin="0,0,16,0">
                                <StackPanel>
                                    <TextBlock Text="Governance Parameters"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,22" />

                                    <Grid Margin="0,0,0,24">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="72" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Per-Trade Risk Budget"
                                                       FontSize="12"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="Interface demonstration only"
                                                       Style="{StaticResource BodySecondary}"
                                                       FontSize="10"
                                                       Margin="0,3,0,0" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding RiskBudgetDisplay}"
                                                   Foreground="{StaticResource AccentBrush}"
                                                   FontFamily="Cascadia Mono, Consolas"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Right" />
                                        <Slider Grid.ColumnSpan="2"
                                                Minimum="0.25"
                                                Maximum="0.75"
                                                Value="{Binding RiskBudget, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                Margin="0,48,0,0" />
                                    </Grid>

                                    <Grid Margin="0,0,0,24">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="72" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Minimum Data Coverage"
                                                       FontSize="12"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="No new risk below the gate"
                                                       Style="{StaticResource BodySecondary}"
                                                       FontSize="10"
                                                       Margin="0,3,0,0" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding CoverageGateDisplay}"
                                                   Foreground="{StaticResource AccentBrush}"
                                                   FontFamily="Cascadia Mono, Consolas"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Right" />
                                        <Slider Grid.ColumnSpan="2"
                                                Minimum="0.70"
                                                Maximum="0.95"
                                                Value="{Binding CoverageGate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                Margin="0,48,0,0" />
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="72" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Single-Factor Weight Cap"
                                                       FontSize="12"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="New factors still start at no more than 5%"
                                                       Style="{StaticResource BodySecondary}"
                                                       FontSize="10"
                                                       Margin="0,3,0,0" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding MaxFactorWeightDisplay}"
                                                   Foreground="{StaticResource AccentBrush}"
                                                   FontFamily="Cascadia Mono, Consolas"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Right" />
                                        <Slider Grid.ColumnSpan="2"
                                                Minimum="0.10"
                                                Maximum="0.35"
                                                Value="{Binding MaxFactorWeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                Margin="0,48,0,0" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <TextBlock Text="Non-Negotiable Boundaries"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,18" />

                                    <TextBlock Text="[OK] At least 252 time-series observations"
                                               FontSize="11"
                                               Margin="0,0,0,12" />
                                    <TextBlock Text="[OK] At least 6 frozen OOS windows"
                                               FontSize="11"
                                               Margin="0,0,0,12" />
                                    <TextBlock Text="[OK] OOS degradation must remain controlled"
                                               FontSize="11"
                                               Margin="0,0,0,12" />
                                    <TextBlock Text="[OK] Positive contribution after costs"
                                               FontSize="11"
                                               Margin="0,0,0,12" />
                                    <TextBlock Text="[OK] Missing values are not neutral zero"
                                               FontSize="11"
                                               Margin="0,0,0,12" />
                                    <TextBlock Text="[OK] Risk gates stay separate from alpha weights"
                                               FontSize="11"
                                               Margin="0,0,0,18" />

                                    <Border Height="1" Background="#22FFFFFF" Margin="0,0,0,14" />
                                    <TextBlock Text="This app does not execute trades"
                                               Foreground="#FFF7B955"
                                               FontSize="11"
                                               FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Style="{StaticResource CardBorder}" Margin="0,18,0,0">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="Current Parameter Proposal"
                                               FontSize="14"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding CurrentProposal}"
                                               Style="{StaticResource BodySecondary}"
                                               Margin="0,6,0,0" />
                                </StackPanel>
                                <Border Width="36"
                                        Height="36"
                                        Background="#2254D38A"
                                        BorderBrush="#5554D38A"
                                        BorderThickness="1"
                                        CornerRadius="18"
                                        HorizontalAlignment="Right">
                                    <TextBlock Text="OK"
                                               Foreground="#FF54D38A"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="PrivacyPanel"
                              Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="34,30,34,38">
                        <TextBlock Text="PRIVACY BY DESIGN"
                                   Style="{StaticResource EyebrowText}" />
                        <TextBlock Text="Sanitized and self-contained"
                                   Style="{StaticResource PageTitle}" />
                        <TextBlock Text="The release contains no production account or personal data."
                                   Style="{StaticResource BodySecondary}"
                                   Margin="0,0,0,22" />

                        <UniformGrid Columns="3" Margin="0,0,0,18">
                            <Border Style="{StaticResource CardBorder}" Margin="0,0,11,0">
                                <StackPanel>
                                    <Border Width="36"
                                            Height="36"
                                            Background="#1855D7F1"
                                            CornerRadius="11"
                                            HorizontalAlignment="Left">
                                        <TextBlock Text="NET"
                                                   Foreground="{StaticResource AccentBrush}"
                                                   FontSize="9"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="No Network Requests"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Margin="0,15,0,6" />
                                    <TextBlock Text="No market-data, broker, or analytics service connections"
                                               Style="{StaticResource BodySecondary}"
                                               FontSize="10" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardBorder}" Margin="5,0,5,0">
                                <StackPanel>
                                    <Border Width="36"
                                            Height="36"
                                            Background="#18A68BFA"
                                            CornerRadius="11"
                                            HorizontalAlignment="Left">
                                        <TextBlock Text="ID"
                                                   Foreground="{StaticResource PurpleBrush}"
                                                   FontSize="9"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="No Identity Data"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Margin="0,15,0,6" />
                                    <TextBlock Text="No account numbers, user names, or device identifiers"
                                               Style="{StaticResource BodySecondary}"
                                               FontSize="10" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardBorder}" Margin="11,0,0,0">
                                <StackPanel>
                                    <Border Width="36"
                                            Height="36"
                                            Background="#1854D38A"
                                            CornerRadius="11"
                                            HorizontalAlignment="Left">
                                        <TextBlock Text="KEY"
                                                   Foreground="#FF54D38A"
                                                   FontSize="9"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="No Secrets"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Margin="0,15,0,6" />
                                    <TextBlock Text="No tokens, certificates, or environment variables"
                                               Style="{StaticResource BodySecondary}"
                                               FontSize="10" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="Release Boundary"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,17" />

                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="88" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="INCLUDES"
                                               Foreground="{StaticResource AccentBrush}"
                                               FontSize="10"
                                               FontWeight="Bold" />
                                    <TextBlock Grid.Column="1"
                                               Text="Native UI, demo factors, an offline state machine, and rule descriptions"
                                               Style="{StaticResource BodySecondary}" />
                                </Grid>

                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="88" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="EXCLUDES"
                                               Foreground="{StaticResource AccentBrush}"
                                               FontSize="10"
                                               FontWeight="Bold" />
                                    <TextBlock Grid.Column="1"
                                               Text="Production code, positions, orders, profit and loss, account bindings, and access tokens"
                                               Style="{StaticResource BodySecondary}" />
                                </Grid>

                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="88" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="STORAGE"
                                               Foreground="{StaticResource AccentBrush}"
                                               FontSize="10"
                                               FontWeight="Bold" />
                                    <TextBlock Grid.Column="1"
                                               Text="No persistence by default; restart restores the built-in demo state"
                                               Style="{StaticResource BodySecondary}" />
                                </Grid>

                                <Grid Margin="0,0,0,17">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="88" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="TRADING"
                                               Foreground="{StaticResource AccentBrush}"
                                               FontSize="10"
                                               FontWeight="Bold" />
                                    <TextBlock Grid.Column="1"
                                               Text="No order, cancellation, account configuration, or fund-management interfaces"
                                               Style="{StaticResource BodySecondary}" />
                                </Grid>

                                <Border Height="1" Background="#22FFFFFF" Margin="0,0,0,15" />
                                <TextBlock Text="Suitable for demos, reviews, and UI prototyping. Not investment advice."
                                           Foreground="#FF54D38A"
                                           FontSize="12"
                                           FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>
