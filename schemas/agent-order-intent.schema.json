{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cytisus.local/schemas/agent-order-intent.schema.json",
  "title": "Agent Order Intent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "intent_id",
    "agent_session_id",
    "model_id",
    "account_id",
    "authorization_id",
    "strategy_id",
    "symbol",
    "side",
    "quantity_or_notional",
    "order_type",
    "limit_price_optional",
    "time_in_force",
    "outside_regular_hours",
    "reason",
    "confidence",
    "created_at",
    "expires_at"
  ],
  "properties": {
    "intent_id": {
      "type": "string",
      "minLength": 1
    },
    "authorization_id": {
      "type": "string",
      "minLength": 1
    },
    "agent_session_id": {
      "type": "string",
      "minLength": 1
    },
    "model_id": {
      "type": "string",
      "minLength": 1
    },
    "account_id": {
      "type": "string",
      "minLength": 1
    },
    "strategy_id": {
      "type": "string",
      "minLength": 1
    },
    "symbol": {
      "type": "string",
      "minLength": 1
    },
    "side": {
      "enum": ["Buy", "Sell"]
    },
    "quantity_or_notional": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "order_type": {
      "enum": ["Market", "Limit"]
    },
    "limit_price_optional": {
      "type": ["number", "null"],
      "exclusiveMinimum": 0
    },
    "time_in_force": {
      "enum": ["Day", "GoodTilCancelled", "ImmediateOrCancel", "FillOrKill"]
    },
    "outside_regular_hours": {
      "type": "boolean"
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
