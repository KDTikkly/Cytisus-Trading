{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cytisus.example/schemas/market-snapshot.schema.json",
  "title": "Current Market Snapshot",
  "type": "object",
  "required": [
    "schema_version",
    "symbol",
    "event_time",
    "available_time",
    "collected_at",
    "source_version",
    "adjustment_mode",
    "data_hash",
    "last",
    "volume",
    "currency"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "symbol": {
      "type": "string"
    },
    "event_time": {
      "type": "string",
      "format": "date-time"
    },
    "available_time": {
      "type": "string",
      "format": "date-time"
    },
    "collected_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_version": {
      "type": "string"
    },
    "adjustment_mode": {
      "type": "string"
    },
    "data_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "last": {
      "type": "number"
    },
    "open": {
      "type": "number"
    },
    "high": {
      "type": "number"
    },
    "low": {
      "type": "number"
    },
    "previous_close": {
      "type": "number"
    },
    "volume": {
      "type": "number",
      "minimum": 0
    },
    "currency": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
