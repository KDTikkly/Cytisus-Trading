{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/KDTikkly/Cytisus-Trading/schemas/strategy-manifest.schema.json",
  "title": "Cytisus Strategy Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "protocol_version",
    "strategy_id",
    "name",
    "version",
    "source",
    "entrypoint",
    "supported_modes",
    "required_data",
    "parameter_schema_version",
    "parameter_schema",
    "requested_capabilities"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "protocol_version": {
      "const": 1
    },
    "strategy_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "source": {
      "enum": [
        "Official",
        "ThirdParty"
      ]
    },
    "entrypoint": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "supported_modes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "PaperOnly",
          "Live"
        ]
      }
    },
    "required_data": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9_]+$"
      }
    },
    "parameter_schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "parameter_schema": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "requested_capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "market_data",
          "strategy_events",
          "structured_logs"
        ]
      }
    }
  }
}
