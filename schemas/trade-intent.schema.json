{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/KDTikkly/Cytisus-Trading/schemas/trade-intent.schema.json",
  "title": "Cytisus Trade Intent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "intent_id",
    "strategy_id",
    "strategy_version",
    "cycle_id",
    "settlement_cycle",
    "symbol",
    "requested_quantity",
    "priority",
    "allow_partial",
    "minimum_effective_fill",
    "time_to_live_seconds",
    "reason_code",
    "parameter_version",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "intent_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "strategy_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "strategy_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32
    },
    "cycle_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "settlement_cycle": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "symbol": {
      "type": "string",
      "pattern": "^[A-Z0-9.-]{1,32}$"
    },
    "requested_quantity": {
      "type": "number",
      "not": {
        "const": 0
      }
    },
    "priority": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000
    },
    "allow_partial": {
      "type": "boolean"
    },
    "minimum_effective_fill": {
      "type": "number",
      "minimum": 0
    },
    "time_to_live_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 86400
    },
    "reason_code": {
      "type": "string",
      "pattern": "^[a-z0-9_]{1,120}$"
    },
    "parameter_version": {
      "type": "integer",
      "minimum": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
