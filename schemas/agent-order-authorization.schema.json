{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cytisus.local/schemas/agent-order-authorization.schema.json",
  "title": "Agent Order Authorization",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "authorization_id",
    "mode",
    "allowed_accounts",
    "allowed_markets",
    "allowed_strategies",
    "allowed_symbols_or_universe",
    "maximum_order_value",
    "maximum_daily_value",
    "maximum_position",
    "maximum_daily_loss",
    "max_orders_per_day",
    "allowed_order_types",
    "allowed_trading_hours",
    "outside_regular_hours_permission",
    "minimum_confidence",
    "valid_from",
    "expires_at",
    "revoked"
  ],
  "properties": {
    "authorization_id": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": [
        "SuggestOnly",
        "ConfirmEveryOrder",
        "BoundedAutonomy"
      ]
    },
    "allowed_strategies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "allowed_accounts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "allowed_markets": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "allowed_symbols_or_universe": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "maximum_order_value": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "maximum_daily_value": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "maximum_position": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "maximum_daily_loss": {
      "type": "number",
      "minimum": 0
    },
    "max_orders_per_day": {
      "type": "integer",
      "minimum": 1
    },
    "allowed_order_types": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "allowed_trading_hours": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "outside_regular_hours_permission": {
      "type": "boolean"
    },
    "minimum_confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "valid_from": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "revoked": {
      "type": "boolean"
    }
  }
}
