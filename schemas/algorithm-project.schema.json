{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cytisus.local/schemas/algorithm-project.schema.json",
  "title": "Algorithm Project",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project_id",
    "name",
    "project_type",
    "current_version",
    "versions"
  ],
  "properties": {
    "project_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "project_type": {
      "enum": ["Research", "Training", "Execution"]
    },
    "current_version": {
      "type": "integer",
      "minimum": 1
    },
    "versions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["version", "created_at", "source", "files"],
        "properties": {
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "source": {
            "enum": ["User", "AgentPatch", "Fixture", "Import"]
          },
          "files": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["relative_path", "sha256", "size_bytes"],
              "properties": {
                "relative_path": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "size_bytes": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        }
      }
    }
  }
}
