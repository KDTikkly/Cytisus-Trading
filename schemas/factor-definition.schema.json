{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/KDTikkly/Cytisus-Trading/schemas/factor-definition.schema.json",
  "title": "Cytisus Factor Definition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "factor_id",
    "factor_type",
    "target",
    "horizon",
    "universe",
    "required_data",
    "update_frequency",
    "version",
    "state",
    "expression"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "factor_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
    },
    "factor_type": {
      "enum": [
        "Alpha",
        "Risk",
        "Regime",
        "Liquidity",
        "Execution"
      ]
    },
    "target": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "horizon": {
      "enum": [
        "1d",
        "3d",
        "5d",
        "10d",
        "20d",
        "60d",
        "120d",
        "252d",
        "1m",
        "5m",
        "30m"
      ]
    },
    "universe": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "required_data": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9_]+$"
      }
    },
    "update_frequency": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "state": {
      "enum": [
        "Candidate",
        "Shadow",
        "Active",
        "Reduced",
        "Probation",
        "Retired",
        "Quarantined"
      ]
    },
    "expression": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    }
  }
}
