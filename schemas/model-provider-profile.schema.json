{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cytisus.local/schemas/model-provider-profile.schema.json",
  "title": "Cytisus Model Provider Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "provider_id",
    "display_name",
    "protocol_type",
    "base_url",
    "enabled",
    "request_timeout_seconds",
    "created_at",
    "updated_at",
    "last_test_status",
    "last_test_message",
    "secret_reference"
  ],
  "properties": {
    "provider_id": {
      "type": "string",
      "minLength": 1
    },
    "display_name": {
      "type": "string",
      "minLength": 1
    },
    "protocol_type": {
      "enum": [
        "OpenAICompatible",
        "AnthropicCompatible",
        "GeminiCompatible"
      ]
    },
    "base_url": {
      "type": "string",
      "format": "uri"
    },
    "enabled": {
      "type": "boolean"
    },
    "request_timeout_seconds": {
      "type": "integer",
      "minimum": 2,
      "maximum": 120
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_tested_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "last_test_status": {
      "enum": [
        "NotConfigured",
        "NotVerified",
        "Ready",
        "Degraded",
        "RateLimited",
        "Unauthorized",
        "Unavailable",
        "Disabled"
      ]
    },
    "last_test_message": {
      "type": "string"
    },
    "secret_reference": {
      "type": "string",
      "minLength": 1
    }
  }
}
